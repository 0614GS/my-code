# 可选的 CI 或临时覆盖。本地使用时优先执行：mycode auth login
ANTHROPIC_API_KEY=

# 可选覆盖项
MY_CODE_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MY_CODE_API_KEY=temporary-provider-key

# 可选：将全局设置、会话记录和工具结果移出 ~/.my-code
# MY_CODE_CONFIG_DIR=/path/to/private/my-code-state
