# 复制为 .env.harbor 后填写。该文件会被 .gitignore 忽略。
# adapter 直接使用这些 my-code 原生参数；Harbor 不解析或推断 provider。
MYCODE_API_KEY=
MYCODE_BASE_URL=https://api.openai.com/v1
MYCODE_MODEL=gpt-5-mini
MYCODE_PROTOCOL=openai-responses

# 默认只跑一个任务，适合作为首次 smoke test。
HARBOR_DATASET=swe-bench/swe-bench-verified
HARBOR_N_TASKS=1
HARBOR_N_ATTEMPTS=1
HARBOR_N_CONCURRENT=1
HARBOR_JOB_NAME=mycode-swe-smoke
HARBOR_JOBS_DIR=jobs

# 脚本会自动允许 MYCODE_BASE_URL 的主机。这里可以额外添加另一个主机名或 IP。
HARBOR_ALLOW_AGENT_HOST=

# 每次默认重建 wheel/constraints/manifest。设为 0 可复用已有 artifact。
HARBOR_REBUILD_ARTIFACTS=1
HARBOR_ARTIFACT_DIR=/tmp/mycode-harbor-artifacts

# 设为 1 时只做 Harbor 配置与 preflight 校验，不下载或执行数据集。
HARBOR_DRY_RUN=0

# 设为 1 会自动确认 Harbor 的安全提示；默认保留人工确认。
HARBOR_YES=0
